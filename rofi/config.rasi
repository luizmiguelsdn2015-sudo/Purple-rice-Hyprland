/* Rofi - Catppuccin Macchiato (accento Mauve)
   Mesma paleta do tema GTK e do Qt (Kvantum).
   Estrutura/medidas preservadas do config original. */

configuration {
    modes: "drun";
    sorting-method: "normal";
    show-icons: true;
    matching: "regex";
    drun-match-fields: "name";
    display-run: "menu:";
    display-drun: "Launch:";
}

* {
    font: "JetBrains Mono 11";
    background-color: transparent;
    text-color: #a6adc8;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 500;
    y-offset: -20;

    border-radius: 12px;
    border: 0px;

    background-color: #24273a;
}

mainbox {
    padding: 8px;
    background-color: #24273a;
}

inputbar {
    background-color: #363a4f;
    border-radius: 6px;
    border: 0px;

    padding: 8px 12px;
    spacing: 8px;
}

prompt {
    text-color: #c6a0f6;
    background-color: transparent;
}

entry {
    text-color: #cad3f5;
    placeholder: "apps";
    placeholder-color: #6c6f85;
    background-color: transparent;
}

listview {
    background-color: #1e2030;
    margin: 8px 0 0;

    columns: 1;
    lines: 6;
    fixed-height: false;
}

/* ===== Elements ===== */
element {
    padding: 8px 10px;
    spacing: 6px;
    border-radius: 6px;
}

element normal.normal {
    background-color: #1e2030;
    text-color: #a6adc8;
}

element alternate.normal {
    background-color: #1e2030;
    text-color: #a6adc8;
}

element normal.urgent {
    background-color: #363a4f;
    text-color: #f9e2af;
}

element normal.active {
    background-color: #1e2030;
    text-color: #a6adc8;
}

element selected.normal,
element selected.active {
    background-color: #494d64;
    text-color: #cad3f5;
}

element selected.urgent {
    background-color: #494d64;
    text-color: #f9e2af;
}

element-icon {
    size: 1em;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    text-color: inherit;
    background-color: transparent;
}

message {
    margin: 8px 0 0;
    border-radius: 8px;
    border: 0px;

    background-color: #1e2030;
}

textbox {
    padding: 8px 16px;
    background-color: #1e2030;
}
